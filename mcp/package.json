{
  "name": "@ostraagent/mcp",
  "version": "0.1.9",
  "private": true,
  "description": "Ostra Agent's MCP server (stdio): the post-quantum privacy vault for AI agents. One vault to pay, earn, work and hire on Ostrapad, and stay private on Robinhood Chain, with no ETH (the Ostra relayer sends its transactions, paid in USDG).",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "ostra-mcp": "src/server.ts"
  },
  "scripts": {
    "start": "node src/server.ts",
    "test": "node --test \"test/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json",
    "bundle": "node scripts/pack.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@ostraagent/core": "file:../core",
    "@ostraagent/sdk": "file:../sdk",
    "@ostraagent/swap": "file:../../ostra-swap/sdk",
    "viem": "2.57.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  }
}
