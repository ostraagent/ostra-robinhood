# Ostra RPC proxy on Robinhood Chain: reads and simulations for the web app.
# Installed by the setup step of the deploy (README: Running on mainnet), with @NODE@ replaced by the path of node.
[Unit]
Description=Ostra RPC proxy on Robinhood Chain: reads and simulations for the web app
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/srv/apps/ostra-robinhood/rpc-proxy
EnvironmentFile=/etc/ostra/robinhood/rpc-proxy.env
ExecStart=@NODE@ src/main.ts
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/etc/ostra/robinhood

[Install]
WantedBy=multi-user.target
