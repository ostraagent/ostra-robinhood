# The remote MCP gateway's environment (mcp/src/remote.ts; the OSTRA_* that are not OSTRA_REMOTE_* are passed to each
# session's server, mcp/src/config.ts). No secret in it. Installed as /etc/ostra/robinhood/remote-mcp.env (0600).
OSTRA_REMOTE_PUBLIC_URL=https://mcp.ostraagent.xyz
OSTRA_REMOTE_APP_URL=https://app.ostraagent.xyz
OSTRA_REMOTE_LISTEN=127.0.0.1:4920
OSTRA_REMOTE_ALLOWED_HOSTS=mcp.ostraagent.xyz
OSTRA_REMOTE_ROOT=/var/lib/ostra-remote-mcp
# Operators' fixed tokens (mcp/scripts/remote-user.ts): none but while a deploy checks a session.
OSTRA_REMOTE_USERS=/var/lib/ostra-remote-mcp/users.json
OSTRA_REMOTE_SANDBOX=bwrap
OSTRA_REMOTE_SANDBOX_RO=/srv/apps/ostra-swap/privacy/wasm/pkg
OSTRA_DEPLOYMENT=/srv/apps/ostra-robinhood/deployments/robinhood-mainnet.json
OSTRA_SWAP_DEPLOYMENT=/srv/apps/ostra-swap/deployments/robinhood-mainnet.json
OSTRA_PROVER_WASM=/srv/apps/ostra-swap/privacy/wasm/pkg
# Ostra's services, as the npm package has them (scripts/pack.ts SERVICES, config.ts). The chain through the public
# RPC, as the npm package reads it.
OSTRA_RELAYER_URL=https://relayer.ostraagent.xyz
OSTRA_KEEPER_URL=https://keeper.ostraagent.xyz
OSTRA_AGGREGATOR_URL=https://aggregator.ostraagent.xyz
OSTRA_AI_URL=https://ai.ostraagent.xyz
OSTRA_PAD_INDEXER_URL=https://app.ostraagent.xyz
OSTRA_HISTORY_RPC_URL=https://rpc.ostraagent.xyz
