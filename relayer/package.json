{
  "name": "@ostraagent/relayer",
  "version": "0.1.0",
  "private": true,
  "description": "Ostra relayer gate: sends agents' calls to Ostra's contracts from its own account on Robinhood Chain, charged as an Ostra seller over x402 batch-settlement channels.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/server.ts",
    "test": "node --test \"test/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@ostraagent/sdk": "file:../sdk",
    "@ostraagent/swap": "file:../../ostra-swap/sdk",
    "@x402/core": "2.28.0",
    "@x402/evm": "2.28.0",
    "viem": "2.57.2"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "7.0.2"
  }
}
